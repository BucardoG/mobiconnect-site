---
// Footer — marca, productos, compañía y línea legal canónica.
import Logo from "./Logo.astro";

interface Props {
  locale: "es" | "en";
  path: string;
  t: {
    tagline: string;
    products: string;
    company: string;
    legal: string;
  };
}

const { locale, t } = Astro.props;
const pre = locale === "en" ? "/en" : "";
const home = locale === "en" ? "/en/" : "/";
---

<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="brand" href={home} aria-label="Mobiconnect">
          <Logo height={24} label="" />
        </a>
        <p class="tagline">{t.tagline}</p>
      </div>

      <nav class="footer-col" aria-label={t.products}>
        <h3 class="mono">{t.products}</h3>
        <ul>
          <li><a href={`${pre}/products/entitlements`}>Entitlements</a></li>
          <li><a href={`${pre}/developers`}>{locale === "en" ? "API Platform" : "Plataforma de APIs"}</a></li>
          <li><a href={`${pre}/open-finance`}>Open Finance</a></li>
          <li><a href={`${pre}/products/people`}>People</a></li>
        </ul>
      </nav>

      <nav class="footer-col" aria-label={t.company}>
        <h3 class="mono">{t.company}</h3>
        <ul>
          <li><a href={`${pre}/about`}>
            {locale === "en" ? "The group" : "El grupo"}
          </a></li>
          <li><a href={`${pre}/contact`}>
            {locale === "en" ? "Contact" : "Contacto"}
          </a></li>
        </ul>
      </nav>
    </div>

    <div class="footer-legal">
      <p>{t.legal}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    background: var(--surface);
    padding-block: 3.5rem 2rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: 2.5rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  .tagline {
    margin-top: 0.9rem;
    font-size: 0.9375rem;
    color: var(--ink-2);
    max-width: 34ch;
  }

  .footer-col h3 {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin-bottom: 0.9rem;
  }

  .footer-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }

  .footer-col a {
    font-size: 0.9375rem;
    color: var(--ink-2);
    text-decoration: none;
  }

  .footer-col a:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .footer-legal {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .footer-legal p {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    color: var(--ink-3);
  }

  @media (max-width: 680px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
