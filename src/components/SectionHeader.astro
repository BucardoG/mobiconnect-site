---
// SectionHeader — eyebrow mono + titular + lede.
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
}

const { eyebrow, title, lede } = Astro.props;
---

<header class="section-header">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2>{title}</h2>
  {lede && <p class="lede">{lede}</p>}
</header>

<style>
  .section-header {
    max-width: 46rem;
    margin-bottom: clamp(2.25rem, 5vw, 3.5rem);
  }

  .section-header h2 + .lede {
    margin-top: 1.25rem;
  }
</style>
