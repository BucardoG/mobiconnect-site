---
// StatBlock — valor mono grande + etiqueta. Solo datos verificables.
interface Props {
  value: string;
  label: string;
}

const { value, label } = Astro.props;
---

<div class="stat">
  <span class="stat-value mono">{value}</span>
  <span class="stat-label">{label}</span>
</div>

<style>
  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--line);
  }

  .stat-value {
    font-size: clamp(1.75rem, 3vw, 2.375rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--ink);
    line-height: 1.1;
  }

  .stat-label {
    font-size: 0.875rem;
    color: var(--ink-2);
    max-width: 24ch;
  }
</style>
