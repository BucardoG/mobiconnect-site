---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import SectionHeader from "../components/SectionHeader.astro";
import FeatureCard from "../components/FeatureCard.astro";
import CTABand from "../components/CTABand.astro";
---

<Base
  title="Developers — Mobiconnect"
  description="El portal de desarrolladores de Mobiconnect: documentación pública de Entitlements v1, en staging. Referencia de la API, autenticación, errores y conceptos del contrato en mobiconnect.dev."
  locale="es"
  path="/developers"
>
  <Hero
    eyebrow="Portal de developers"
    title="mobiconnect.dev: la documentación pública de la API."
    sub="Referencia de Entitlements v1, autenticación, errores y los conceptos del contrato. API Ready por diseño: razones de decisión en un enum cerrado y respuestas deterministas, pensadas para que también un agente AI las consuma. La especificación OpenAPI y el modelo de errores unificado están en camino. Hoy corre en staging, con tenants sintéticos y sin dinero real."
    ctaPrimary={{ label: "Abrir mobiconnect.dev", href: "https://mobiconnect.dev" }}
    ctaSecondary={{ label: "Conocer la Plataforma de APIs", href: "/platform" }}
    panelLabel="Estado del portal"
    panel={[
      { k: "DOMINIO", v: "mobiconnect.dev" },
      { k: "ESTADO", v: "PUBLICADO · API EN STAGING" },
      { k: "ESTÁNDAR", v: "CAMARA (GSMA)" },
      { k: "IDIOMA", v: "ESPAÑOL" },
    ]}
  />

  <section class="section section--rule">
    <div class="container">
      <SectionHeader
        eyebrow="Qué encuentras hoy"
        title="Tres piezas, un mismo contrato."
        lede="Lo que un integrador necesita para entender la primera decisión de Entitlements antes de escribir una línea de código."
      />
      <div class="grid grid--3">
        <FeatureCard
          kicker="01 · Referencia"
          title="La API, contrato por contrato."
          body="POST /v1/entitlements/check y /release, administración y salud: encabezados, cuerpo, razones de decisión y respuestas."
          points={[
            "Razones de decisión en un enum cerrado",
            "Errores con su semántica y qué hacer",
            "Ejemplos sobre staging, nunca datos reales",
          ]}
        />
        <FeatureCard
          kicker="02 · Autenticación"
          title="OAuth2 hoy; claves con la consola."
          body="Hoy: OAuth2 client_credentials con tokens de una hora y scopes por cliente, contra staging. Las claves atk_test_ y atk_live_ llegan con la consola del portal, en construcción."
          points={[
            "OAuth2 client_credentials, tokens de una hora",
            "Scopes explícitos por cliente",
            "Producción se habilita con la apertura pública",
          ]}
        />
        <FeatureCard
          kicker="03 · Conceptos"
          title="El contrato, antes del código."
          body="Planes y cuotas, decisiones de autorización, idempotencia y fail-closed, explicados antes de la primera llamada."
          points={[
            "Deny-by-default: sin autorización explícita, no se sirve",
            "Idempotency-Key en cada escritura con efecto económico",
            "Fail-closed: si no se puede decidir, no se sirve",
          ]}
        />
      </div>
    </div>
  </section>

  <section class="section section--rule">
    <div class="container">
      <SectionHeader
        eyebrow="Principios"
        title="Un contrato es una promesa."
        lede="Cuatro reglas que gobiernan cómo documentamos, qué prometemos y qué no."
      />
      <div class="grid grid--2">
        <FeatureCard
          highlight={true}
          title="Cuota agotada no es error."
          body="Cuando el plan se agota, la API responde 200 con allow:false y la razón. El 429 pertenece al gateway, no al contrato. Predecibilidad primero."
        />
        <FeatureCard
          title="Cero datos reales en la documentación."
          body="Los ejemplos corren sobre staging, con tenants sintéticos y sin dinero real. Ningún dato de clientes aparece en material público."
        />
        <FeatureCard
          title="El estado, dicho en voz alta."
          body="Cada API del portal declara su estado: staging, en construcción o en diseño. No documentamos como disponible lo que no corre."
        />
        <FeatureCard
          title="Lo que falta, por escrito."
          body="La consola de pruebas en el navegador, la versión en inglés y la conformidad CAMARA completa están en la hoja de ruta. Se anuncian cuando corran."
        />
      </div>
    </div>
  </section>

  <CTABand
    eyebrow="Acceso anticipado"
    title="Construye con nosotros antes que nadie."
    body="Estamos abriendo un grupo reducido de equipos para probar Entitlements en staging. Si vendes o consumes una API como producto, hablemos."
    button="Solicitar acceso"
    href="/contact"
  />
</Base>
