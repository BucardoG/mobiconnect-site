---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import SectionHeader from "../components/SectionHeader.astro";
import FeatureCard from "../components/FeatureCard.astro";
import StatBlock from "../components/StatBlock.astro";
import CTABand from "../components/CTABand.astro";
import Diagram from "../components/Diagram.astro";
import decision from "../assets/visual/v1-flujo-decision.svg?raw";
import economy from "../assets/visual/v2-economia-agentes.svg?raw";
import contract from "../assets/visual/v6-contrato-legible.svg?raw";
import entitlementsIcon from "../assets/visual/icons/1.svg?raw";
import platformIcon from "../assets/visual/icons/2.svg?raw";
import openFinanceIcon from "../assets/visual/icons/3.svg?raw";
import numberIntelligenceIcon from "../assets/visual/icons/4.svg?raw";
import peopleIcon from "../assets/visual/icons/5.svg?raw";
import { es } from "../i18n";

const t = es.home;
const productIcons = [entitlementsIcon, platformIcon, openFinanceIcon, numberIntelligenceIcon, peopleIcon];
---

<Base title={t.meta.title} description={t.meta.description} locale="es" path="/">
  <Hero
    eyebrow={t.hero.eyebrow}
    title={t.hero.title}
    sub={t.hero.sub}
    ctaPrimary={t.hero.ctaPrimary}
    ctaSecondary={t.hero.ctaSecondary}
    panel={t.hero.panel}
    panelLabel={t.hero.panelLabel}
  />

  <section class="section section--rule">
    <div class="container">
      <SectionHeader eyebrow="Cómo decide" title="Una decisión antes de cada llamada." />
      <Diagram
        svg={decision}
        caption="Personas, aplicaciones y agentes AI pasan por la misma decisión: permiso, cuota y precio. Cada unidad servida queda medida."
      />
    </div>
  </section>

  <!-- Tesis -->
  <section class="section section--rule">
    <div class="container thesis-grid">
      <SectionHeader eyebrow={t.thesis.eyebrow} title={t.thesis.title} />
      <div class="prose">
        {t.thesis.body.map((p) => <p>{p}</p>)}
      </div>
    </div>
    <div class="container thesis-diagram">
      <Diagram svg={economy} caption="La economía de agentes exige contratos legibles por máquina." />
    </div>
  </section>

  <!-- Productos -->
  <section class="section section--rule" id="productos">
    <div class="container">
      <SectionHeader eyebrow={t.products.eyebrow} title={t.products.title} lede={t.products.lede} />
      <div class="grid grid--2 products-grid">
        {
          t.products.items.map((item, index) => (
            <FeatureCard
              icon={productIcons[index]}
              kicker={item.kicker}
              title={item.title}
              body={item.body}
              points={item.points}
              href={item.href}
              cta={item.cta}
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--rule">
    <div class="container">
      <SectionHeader eyebrow="Contrato" title="Del PDF a la regla que se ejecuta." />
      <Diagram
        svg={contract}
        caption="Cada consumo se evalúa contra el contrato, no contra un PDF."
      />
    </div>
  </section>

  <!-- Grupo -->
  <section class="section section--rule">
    <div class="container group-grid">
      <div>
        <SectionHeader eyebrow={t.group.eyebrow} title={t.group.title} />
        <div class="prose">
          <p>{t.group.body}</p>
        </div>
        <p><a class="link-arrow" href={t.group.cta.href}>{t.group.cta.label} <span aria-hidden="true">→</span></a></p>
      </div>
      <div class="group-stats">
        {t.group.stats.map((s) => <StatBlock value={s.value} label={s.label} />)}
      </div>
    </div>
  </section>

  <CTABand
    eyebrow={es.shared.cta.eyebrow}
    title={es.shared.cta.title}
    body={es.shared.cta.body}
    button={es.shared.cta.button}
    href="/contact"
  />
</Base>

<style>
  /* Número impar de productos: el último (segunda línea) ocupa la fila completa. */
  .products-grid > :global(:last-child:nth-child(odd)) {
    grid-column: 1 / -1;
  }

  .thesis-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  .thesis-diagram {
    margin-top: clamp(2rem, 5vw, 3.5rem);
  }

  .group-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }

  .group-grid .prose {
    margin-bottom: 1.75rem;
  }

  .group-stats {
    display: grid;
    gap: 0.75rem;
  }

  @media (max-width: 900px) {
    .thesis-grid,
    .group-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
