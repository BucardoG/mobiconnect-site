---
import Base from "../../layouts/Base.astro";
import Hero from "../../components/Hero.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import FeatureCard from "../../components/FeatureCard.astro";
import Steps from "../../components/Steps.astro";
import CodeBlock from "../../components/CodeBlock.astro";
import FAQ from "../../components/FAQ.astro";
import CTABand from "../../components/CTABand.astro";
import Diagram from "../../components/Diagram.astro";
import idempotency from "../../assets/visual/v3-idempotencia.svg?raw";
import failClosed from "../../assets/visual/v4-fail-closed.svg?raw";
import { es } from "../../i18n";

const t = es.entitlements;
---

<Base title={t.meta.title} description={t.meta.description} locale="es" path="/products/entitlements">
  <Hero
    eyebrow={t.hero.eyebrow}
    title={t.hero.title}
    sub={t.hero.sub}
    ctaPrimary={t.hero.ctaPrimary}
    ctaSecondary={t.hero.ctaSecondary}
    panel={t.hero.panel}
    panelLabel={t.hero.panelLabel}
  />

  <!-- Capacidades -->
  <section class="section section--rule">
    <div class="container">
      <SectionHeader eyebrow={t.features.eyebrow} title={t.features.title} lede={t.features.lede} />
      <div class="grid grid--3">
        {
          t.features.items.map((item) => (
            <FeatureCard kicker={item.kicker} title={item.title} body={item.body} />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--rule">
    <div class="container">
      <SectionHeader eyebrow="Garantías" title="Idempotencia y fail-closed." />
      <div class="diagram-stack">
        <Diagram svg={idempotency} caption="Un reintento con el mismo correlation_id responde 409: nunca se cobra dos veces." />
        <Diagram svg={failClosed} caption="Si el decisor no responde, la llamada se detiene con 503 pdp_unavailable." />
      </div>
    </div>
  </section>

  <!-- Cómo funciona -->
  <section class="section section--rule">
    <div class="container">
      <SectionHeader eyebrow={t.how.eyebrow} title={t.how.title} />
      <Steps steps={t.how.steps} />
      <div class="code-wrap">
        <CodeBlock filename={t.code.filename} code={t.code.code} note={t.code.note} />
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section--rule">
    <div class="container">
      <SectionHeader eyebrow={t.faq.eyebrow} title={t.faq.title} />
      <FAQ items={t.faq.items} />
    </div>
  </section>

  <CTABand
    eyebrow={es.shared.cta.eyebrow}
    title={es.shared.cta.title}
    body={es.shared.cta.body}
    button={es.shared.cta.button}
    href="/contact"
  />
</Base>

<style>
  .diagram-stack {
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.5rem);
  }

  .code-wrap {
    margin-top: clamp(2rem, 5vw, 3.25rem);
    max-width: 46rem;
  }
</style>
