---
import Base from "../../../layouts/Base.astro";
import Hero from "../../../components/Hero.astro";
import SectionHeader from "../../../components/SectionHeader.astro";
import FeatureCard from "../../../components/FeatureCard.astro";
import Steps from "../../../components/Steps.astro";
import CodeBlock from "../../../components/CodeBlock.astro";
import FAQ from "../../../components/FAQ.astro";
import CTABand from "../../../components/CTABand.astro";
import Diagram from "../../../components/Diagram.astro";
import idempotency from "../../../assets/visual/v3-idempotencia.en.svg?raw";
import failClosed from "../../../assets/visual/v4-fail-closed.en.svg?raw";
import { en } from "../../../i18n";

const t = en.entitlements;
---

<Base title={t.meta.title} description={t.meta.description} locale="en" path="/products/entitlements">
  <Hero
    eyebrow={t.hero.eyebrow}
    title={t.hero.title}
    sub={t.hero.sub}
    ctaPrimary={t.hero.ctaPrimary}
    ctaSecondary={t.hero.ctaSecondary}
    panel={t.hero.panel}
    panelLabel={t.hero.panelLabel}
  />

  <!-- Capabilities -->
  <section class="section section--rule">
    <div class="container">
      <SectionHeader eyebrow={t.features.eyebrow} title={t.features.title} lede={t.features.lede} />
      <div class="grid grid--3">
        {
          t.features.items.map((item) => (
            <FeatureCard kicker={item.kicker} title={item.title} body={item.body} />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--rule">
    <div class="container">
      <SectionHeader eyebrow="Guarantees" title="Idempotency and fail-closed." />
      <div class="diagram-stack">
        <Diagram svg={idempotency} caption="A retry with the same correlation_id returns 409: it is never charged twice." />
        <Diagram svg={failClosed} caption="If the decision point does not answer, the call stops with 503 pdp_unavailable." />
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="section section--rule">
    <div class="container">
      <SectionHeader eyebrow={t.how.eyebrow} title={t.how.title} />
      <Steps steps={t.how.steps} />
      <div class="code-wrap">
        <CodeBlock filename={t.code.filename} code={t.code.code} note={t.code.note} />
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section--rule">
    <div class="container">
      <SectionHeader eyebrow={t.faq.eyebrow} title={t.faq.title} />
      <FAQ items={t.faq.items} />
    </div>
  </section>

  <CTABand
    eyebrow={en.shared.cta.eyebrow}
    title={en.shared.cta.title}
    body={en.shared.cta.body}
    button={en.shared.cta.button}
    href="/en/contact"
  />
</Base>

<style>
  .diagram-stack {
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.5rem);
  }

  .code-wrap {
    margin-top: clamp(2rem, 5vw, 3.25rem);
    max-width: 46rem;
  }
</style>
