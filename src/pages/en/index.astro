---
import Base from "../../layouts/Base.astro";
import Hero from "../../components/Hero.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import FeatureCard from "../../components/FeatureCard.astro";
import StatBlock from "../../components/StatBlock.astro";
import CTABand from "../../components/CTABand.astro";
import Diagram from "../../components/Diagram.astro";
import decision from "../../assets/visual/v1-flujo-decision.en.svg?raw";
import economy from "../../assets/visual/v2-economia-agentes.en.svg?raw";
import contract from "../../assets/visual/v6-contrato-legible.en.svg?raw";
import entitlementsIcon from "../../assets/visual/icons/1.svg?raw";
import platformIcon from "../../assets/visual/icons/2.svg?raw";
import openFinanceIcon from "../../assets/visual/icons/3.svg?raw";
import numberIntelligenceIcon from "../../assets/visual/icons/4.svg?raw";
import peopleIcon from "../../assets/visual/icons/5.svg?raw";
import { en } from "../../i18n";

const t = en.home;
const productIcons = [entitlementsIcon, platformIcon, openFinanceIcon, numberIntelligenceIcon, peopleIcon];
---

<Base title={t.meta.title} description={t.meta.description} locale="en" path="/">
  <Hero
    eyebrow={t.hero.eyebrow}
    title={t.hero.title}
    sub={t.hero.sub}
    ctaPrimary={t.hero.ctaPrimary}
    ctaSecondary={t.hero.ctaSecondary}
    panel={t.hero.panel}
    panelLabel={t.hero.panelLabel}
  />

  <section class="section section--rule">
    <div class="container">
      <SectionHeader eyebrow="How it decides" title="A decision before every call." />
      <Diagram
        svg={decision}
        caption="People, apps and AI agents go through the same decision: permission, quota and price. Every unit served is metered."
      />
    </div>
  </section>

  <!-- Thesis -->
  <section class="section section--rule">
    <div class="container thesis-grid">
      <SectionHeader eyebrow={t.thesis.eyebrow} title={t.thesis.title} />
      <div class="prose">
        {t.thesis.body.map((p) => <p>{p}</p>)}
      </div>
    </div>
    <div class="container thesis-diagram">
      <Diagram svg={economy} caption="The agent economy demands machine-readable contracts." />
    </div>
  </section>

  <!-- Products -->
  <section class="section section--rule" id="products">
    <div class="container">
      <SectionHeader eyebrow={t.products.eyebrow} title={t.products.title} lede={t.products.lede} />
      <div class="grid grid--2 products-grid">
        {
          t.products.items.map((item, index) => (
            <FeatureCard
              icon={productIcons[index]}
              kicker={item.kicker}
              title={item.title}
              body={item.body}
              points={item.points}
              href={item.href}
              cta={item.cta}
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--rule">
    <div class="container">
      <SectionHeader eyebrow="Contract" title="From a PDF to a rule that runs." />
      <Diagram
        svg={contract}
        caption="Every call is evaluated against the contract, not a PDF."
      />
    </div>
  </section>

  <!-- Group -->
  <section class="section section--rule">
    <div class="container group-grid">
      <div>
        <SectionHeader eyebrow={t.group.eyebrow} title={t.group.title} />
        <div class="prose">
          <p>{t.group.body}</p>
        </div>
        <p><a class="link-arrow" href={t.group.cta.href}>{t.group.cta.label} <span aria-hidden="true">→</span></a></p>
      </div>
      <div class="group-stats">
        {t.group.stats.map((s) => <StatBlock value={s.value} label={s.label} />)}
      </div>
    </div>
  </section>

  <CTABand
    eyebrow={en.shared.cta.eyebrow}
    title={en.shared.cta.title}
    body={en.shared.cta.body}
    button={en.shared.cta.button}
    href="/en/contact"
  />
</Base>

<style>
  /* Número impar de productos: el último (segunda línea) ocupa la fila completa. */
  .products-grid > :global(:last-child:nth-child(odd)) {
    grid-column: 1 / -1;
  }

  .thesis-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  .thesis-diagram {
    margin-top: clamp(2rem, 5vw, 3.5rem);
  }

  .group-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }

  .group-grid .prose {
    margin-bottom: 1.75rem;
  }

  .group-stats {
    display: grid;
    gap: 0.75rem;
  }

  @media (max-width: 900px) {
    .thesis-grid,
    .group-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
