---
import Base from "../../layouts/Base.astro";
import Hero from "../../components/Hero.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import FeatureCard from "../../components/FeatureCard.astro";
import CTABand from "../../components/CTABand.astro";
---

<Base
  title="Developers — Mobiconnect"
  description="Mobiconnect's developer portal: public documentation for Entitlements v1, in staging. API reference, authentication, errors and contract concepts at mobiconnect.dev."
  locale="en"
  path="/developers"
>
  <Hero
    eyebrow="Developer portal"
    title="mobiconnect.dev: the API's public documentation."
    sub="Entitlements v1 reference, authentication, errors and the contract concepts. API Ready by design: decision reasons in a closed enum and deterministic responses, designed for AI agents to consume too. The OpenAPI specification and the unified error model are on their way. It runs in staging today, with synthetic tenants and no real money."
    ctaPrimary={{ label: "Open mobiconnect.dev", href: "https://mobiconnect.dev" }}
    ctaSecondary={{ label: "About the API Platform", href: "/en/platform" }}
    panelLabel="Portal status"
    panel={[
      { k: "DOMAIN", v: "mobiconnect.dev" },
      { k: "STATUS", v: "PUBLISHED · API IN STAGING" },
      { k: "STANDARD", v: "CAMARA (GSMA)" },
      { k: "LANGUAGE", v: "SPANISH" },
    ]}
  />

  <section class="section section--rule">
    <div class="container">
      <SectionHeader
        eyebrow="What you find today"
        title="Three pieces, one contract."
        lede="What an integrator needs to understand Entitlements' first decision before writing a line of code."
      />
      <div class="grid grid--3">
        <FeatureCard
          kicker="01 · Reference"
          title="The API, contract by contract."
          body="POST /v1/entitlements/check and /release, administration and health: headers, body, decision reasons and responses."
          points={[
            "Decision reasons in a closed enum",
            "Errors with their meaning and what to do",
            "Examples on staging, never real data",
          ]}
        />
        <FeatureCard
          kicker="02 · Authentication"
          title="OAuth2 today; keys with the console."
          body="Today: OAuth2 client_credentials with one-hour tokens and per-client scopes, against staging. atk_test_ and atk_live_ keys arrive with the portal console, under construction."
          points={[
            "OAuth2 client_credentials, one-hour tokens",
            "Explicit scopes per client",
            "Production is enabled at public opening",
          ]}
        />
        <FeatureCard
          kicker="03 · Concepts"
          title="The contract, before the code."
          body="Plans and quotas, authorization decisions, idempotency and fail-closed, explained before the first call."
          points={[
            "Deny-by-default: no explicit authorization, no service",
            "Idempotency-Key on every write with economic effect",
            "Fail-closed: if it cannot decide, it does not serve",
          ]}
        />
      </div>
    </div>
  </section>

  <section class="section section--rule">
    <div class="container">
      <SectionHeader
        eyebrow="Principles"
        title="A contract is a promise."
        lede="Four rules that govern how we document, what we promise and what we do not."
      />
      <div class="grid grid--2">
        <FeatureCard
          highlight={true}
          title="An exhausted quota is not an error."
          body="When the plan runs out, the API answers 200 with allow:false and the reason. The 429 belongs to the gateway, not to the contract. Predictability first."
        />
        <FeatureCard
          title="Zero real data in the documentation."
          body="Examples run on staging, with synthetic tenants and no real money. No customer data appears in public material."
        />
        <FeatureCard
          title="Status, stated plainly."
          body="Every API in the portal declares its status: staging, under construction or in design. We do not document as available what is not running."
        />
        <FeatureCard
          title="What is missing, in writing."
          body="The in-browser test console, the English edition and full CAMARA conformance are on the roadmap. They are announced when they run."
        />
      </div>
    </div>
  </section>

  <CTABand
    eyebrow="Early access"
    title="Build with us before anyone else."
    body="We are opening a small group of teams to test Entitlements in staging. If you sell or consume an API as a product, let's talk."
    button="Request access"
    href="/en/contact"
  />
</Base>
